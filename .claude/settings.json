{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/tools/web-sdlc-harness-guard-ssot-read.mjs",
            "statusMessage": "[web-sdlc-harness] SSOT 재열람 검사 중..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/tools/web-sdlc-harness-check-injection-drift.mjs",
            "statusMessage": "[web-sdlc-harness] 주입 드리프트 검사 중..."
          }
        ]
      }
    ]
  }
}
